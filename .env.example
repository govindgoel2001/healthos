# --- Database ---
DATABASE_URL=postgres://meteor:meteor@postgres:5432/meteor

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Garmin MCP ---
# Auth is done once via `garmin-mcp-auth` into the token volume; these are
# only needed for that one-time interactive login.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=
GARMIN_IS_CN=false
# Transport for the Garmin MCP server: `stdio` spawns `uvx garmin-mcp` inside
# the agent container (default, most reliable); `http` connects to a separate
# garmin-mcp service at GARMIN_MCP_URL if that build exposes HTTP transport.
GARMIN_MCP_TRANSPORT=stdio
GARMIN_MCP_URL=http://garmin-mcp:8080/mcp
# Where garmin-mcp-auth wrote the OAuth tokens (mounted into the agent).
GARMIN_TOKEN_DIR=/root/.garminconnect

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- App ---
PUBLIC_BASE_URL=https://health.usemeteorify.com
TZ=Europe/London

# --- Freshness gate ---
FRESHNESS_POLL_INTERVAL_MIN=10
FRESHNESS_MAX_WAIT_MIN=120
