{
  "name": "meteor-health",
  "version": "0.1.0",
  "private": true,
  "description": "Meteor Health — a single-user personal HealthOS driven by the Hermes agent",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @meteor/db generate",
    "db:migrate": "pnpm --filter @meteor/db migrate",
    "reason": "pnpm --filter @meteor/agent reason",
    "verify:mcp": "pnpm --filter @meteor/mcp-client verify"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
